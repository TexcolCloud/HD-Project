{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "lib": ["ES2023", "DOM", "DOM.Iterable"], "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "types": ["vite/client", "node"]
