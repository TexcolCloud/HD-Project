{
  "name": "dormlink-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "format": "prettier --write src \"*.{ts,json,html}\"",
    "format:check": "prettier --check src \"*.{ts,json,html}\"",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/generated/api.ts",
    "build": "npm run generate:api && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.10",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
