{
  "name": "dormlink-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/generated/api.ts",
    "build": "npm run generate:api && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": { "vue": "3.5.45", "vue-router": "5.4.0" },
  "devDependencies": { "@vitejs/plugin-vue": "6.0.10", "@types/node": "24.10.1", "openapi-typescript": "7.13.0", "typescript": "5.9.3", "vite": "8.3.6", "vitest": "5.1.0", "vue-tsc": "3.3.14" }
}
