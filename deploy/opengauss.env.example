# Local Docker defaults. start-database.ps1 creates ignored deploy/.env.opengauss on first run.
# Set OG_HOST to a remote hostname/IP for an external server; startup then probes TCP only.
OG_HOST=127.0.0.1
OG_PORT=15432
OG_DATABASE=dormlink
OG_USER=dormlink
# Local startup replaces placeholders with independent random passwords. Custom passwords
# require 8-32 characters, upper/lowercase, a digit and a symbol; exclude usernames.
# For the image's shell-based admin bootstrap use letters/digits and symbols such as !, @ or %.
OG_PASSWORD=replace-with-a-local-database-password
OG_ADMIN_PASSWORD=replace-with-a-local-opengauss-admin-password

AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_DAILY_LIMIT=10
# Optional HTTPS SMS adapter. Keep both credentials in the private environment file.
APP_SMS_GATEWAY_URL=
APP_SMS_GATEWAY_TOKEN=
APP_SMS_SIGNING_KEY=

# Optional private directory for a backend running directly on the host.
# FILE_STORAGE=/path/to/existing/uploads
