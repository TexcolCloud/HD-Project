# Copy to deploy/.env.opengauss (ignored by Git). Use a dedicated PG-compatible database.
# Replace with the hostname or address of your own openGauss server.
OG_HOST=your-opengauss-host
OG_PORT=15432
OG_DATABASE=dormlink
OG_USER=dormlink
OG_PASSWORD=replace-with-a-local-database-password

AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_DAILY_LIMIT=10

# Keep the existing private attachment directory when moving only the database.
# Replace with the absolute path on the machine running the backend.
# FILE_STORAGE=/path/to/existing/uploads
