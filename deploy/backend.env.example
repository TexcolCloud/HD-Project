# Install a private copy at /etc/dormlink/backend.env (owner root, mode 0600).
# Only application configuration belongs here; never copy SSH administrator credentials.
SPRING_PROFILES_ACTIVE=opengauss
PORT=8080
SERVER_ADDRESS=127.0.0.1
DB_URL=jdbc:opengauss://database-host:15432/dormlink?stringtype=unspecified&use_boolean=true&currentSchema=public
DB_USER=dormlink
DB_PASSWORD=replace-in-private-environment-file
FILE_STORAGE=/var/lib/dormlink/uploads
APP_SEED=false
# Enable only behind the actual HTTPS reverse proxy.
COOKIE_SECURE=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=replace-with-confirmed-provider-model-id
